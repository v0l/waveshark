/target

# IQ captures are fetched from nostr.download via testdata/fetch.sh rather than
# committed: they are near-incompressible and would bloat history permanently.
testdata/*.cu8
testdata/*.cs8
testdata/*.cs16
testdata/*.cf32
testdata/*.xz

# rtl_433's test corpus, captures and the reference decodes beside them. Same
# reason, plus it belongs to the people who contributed it: testdata/rtl433.toml
# points at the upstream copy rather than vendoring one.
testdata/rtl433/

# Off-air captures and generated datasets: fetched or regenerated, never
# committed. See testdata/offair.toml and crates/amc-data.
testdata/offair/
out/

# Python bytecode from the tools directory.
__pycache__/
*.pyc
